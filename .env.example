# Public canonical origin, set after the domain is purchased (no trailing slash)
VITE_SITE_URL=

# Supabase public project settings. The publishable key is designed for browser use;
# database and Storage RLS policies in supabase/schema.sql enforce access.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is accepted if your project only provides the older key format.
VITE_SUPABASE_ANON_KEY=
VITE_ADMIN_EMAIL=shreegangafiresafety@gmail.com
